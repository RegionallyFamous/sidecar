{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/openstation/",
  "preferredVersions": {
    "php": "8.4",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "siteOptions": {
    "blogname": "OpenStation"
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "JETPACK_DEV_DEBUG": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/RegionallyFamous/sidecar/releases/latest/download/openstation.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "jetpack"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once('/wordpress/wp-load.php');\n\nif (!class_exists('Jetpack')) {\n    throw new RuntimeException('Jetpack was not loaded in the Playground demo.');\n}\nif (!Jetpack::is_module_active('blocks') && !Jetpack::activate_module('blocks', false, false)) {\n    throw new RuntimeException('Could not activate Jetpack Blocks for the Sidebar Window demo.');\n}\n"
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once('/wordpress/wp-load.php');\n\n$admin = get_user_by('login', 'admin');\nif (!$admin instanceof WP_User) {\n    throw new RuntimeException('The Playground admin user was not found.');\n}\n\n$content = <<<'HTML'\n<!-- wp:group {\"align\":\"full\",\"style\":{\"color\":{\"background\":\"#101827\",\"text\":\"#f8fafc\"},\"border\":{\"radius\":\"20px\"},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|80\",\"right\":\"var:preset|spacing|60\",\"bottom\":\"var:preset|spacing|80\",\"left\":\"var:preset|spacing|60\"},\"margin\":{\"bottom\":\"var:preset|spacing|60\"}}},\"layout\":{\"type\":\"constrained\",\"contentSize\":\"820px\"}} -->\n<div class=\"wp-block-group alignfull has-text-color has-background\" style=\"border-radius:20px;color:#f8fafc;background-color:#101827;margin-bottom:var(--wp--preset--spacing--60);padding-top:var(--wp--preset--spacing--80);padding-right:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--80);padding-left:var(--wp--preset--spacing--60)\"><!-- wp:paragraph {\"style\":{\"typography\":{\"textTransform\":\"uppercase\",\"letterSpacing\":\"0.16em\",\"fontSize\":\"0.78rem\"},\"color\":{\"text\":\"#7dd3fc\"}},\"fontFamily\":\"monospace\"} -->\n<p class=\"has-text-color has-monospace-font-family\" style=\"color:#7dd3fc;font-size:0.78rem;letter-spacing:0.16em;text-transform:uppercase\">OpenStation field guide · Gutenberg</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":2,\"style\":{\"typography\":{\"fontSize\":\"clamp(2.4rem, 7vw, 5.6rem)\",\"lineHeight\":\"0.98\",\"letterSpacing\":\"-0.05em\"},\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|40\"}}}} -->\n<h2 class=\"wp-block-heading\" style=\"margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--40);font-size:clamp(2.4rem, 7vw, 5.6rem);letter-spacing:-0.05em;line-height:0.98\">Write here.<br>Keep the sidebar there.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"1.25rem\",\"lineHeight\":\"1.55\"},\"color\":{\"text\":\"#cbd5e1\"}},\"className\":\"is-style-lead\"} -->\n<p class=\"is-style-lead has-text-color\" style=\"color:#cbd5e1;font-size:1.25rem;line-height:1.55\">Sidebar Window gives Gutenberg's Post, Block, and plugin panels an attached inspector pane—so the controls stay visible while your writing canvas stays editable.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|60\"},\"blockGap\":{\"left\":\"var:preset|spacing|50\"}}}} -->\n<div class=\"wp-block-columns\" style=\"margin-top:var(--wp--preset--spacing--60)\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"2.2rem\",\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}},\"textColor\":\"white\"} -->\n<p class=\"has-white-color has-text-color\" style=\"margin-bottom:0;font-size:2.2rem;font-weight:700\">~320 px</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#94a3b8\"},\"spacing\":{\"margin\":{\"top\":\"0.35rem\"}}}} -->\n<p class=\"has-text-color\" style=\"color:#94a3b8;margin-top:0.35rem\">A focused companion, not another full-screen workspace.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"2.2rem\",\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}},\"textColor\":\"white\"} -->\n<p class=\"has-white-color has-text-color\" style=\"margin-bottom:0;font-size:2.2rem;font-weight:700\">Same height</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#94a3b8\"},\"spacing\":{\"margin\":{\"top\":\"0.35rem\"}}}} -->\n<p class=\"has-text-color\" style=\"color:#94a3b8;margin-top:0.35rem\">It attaches directly to the editor's inline edge and follows it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"2.2rem\",\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"bottom\":\"0\"}}},\"textColor\":\"white\"} -->\n<p class=\"has-white-color has-text-color\" style=\"margin-bottom:0;font-size:2.2rem;font-weight:700\">Ephemeral</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#94a3b8\"},\"spacing\":{\"margin\":{\"top\":\"0.35rem\"}}}} -->\n<p class=\"has-text-color\" style=\"color:#94a3b8;margin-top:0.35rem\">Close it freely; only the source editor belongs to your saved session.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:columns {\"style\":{\"spacing\":{\"blockGap\":{\"left\":\"var:preset|spacing|70\"},\"margin\":{\"bottom\":\"var:preset|spacing|70\"}}}} -->\n<div class=\"wp-block-columns\" style=\"margin-bottom:var(--wp--preset--spacing--70)\"><!-- wp:column {\"width\":\"36%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:36%\"><!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"fontSize\":\"2rem\"}}} -->\n<h3 class=\"wp-block-heading\" style=\"font-size:2rem\">How to use it</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>This demo opens Sidebar Window automatically. While it is connected, use Gutenberg's own <strong>Settings</strong> and available plugin-sidebar buttons in the source editor to switch the inspector, or use the always-visible <strong>Sidebar panel</strong> selector in its attached toolbar. Later, use the <strong>Sidebar Window</strong> button in the editor window's title bar to reopen it.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"width\":\"64%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:64%\"><!-- wp:list {\"ordered\":true,\"style\":{\"typography\":{\"fontSize\":\"1.1rem\",\"lineHeight\":\"1.65\"},\"spacing\":{\"blockGap\":\"var:preset|spacing|30\"}}} -->\n<ol style=\"font-size:1.1rem;line-height:1.65\" class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Click Gutenberg's own <strong>Settings</strong> button or an available plugin-sidebar button in the source editor; the existing companion switches to that panel.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Use the companion's <strong>Sidebar panel</strong> selector whenever you want all discovered choices in one place.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Keep editing in the source window while the selected panel stays visible beside it.</li>\n<!-- /wp:list-item -->\n<!-- wp:list-item -->\n<li>Close the companion to restore the source sidebar; later, use <strong>Sidebar Window</strong> in the source title bar to reopen it.</li>\n<!-- /wp:list-item --></ol>\n<!-- /wp:list --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:group {\"style\":{\"color\":{\"background\":\"#e0f2fe\",\"text\":\"#0c4a6e\"},\"border\":{\"radius\":\"16px\",\"left\":{\"color\":\"#0284c7\",\"width\":\"6px\"}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|50\",\"right\":\"var:preset|spacing|50\",\"bottom\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\"},\"margin\":{\"bottom\":\"var:preset|spacing|70\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group has-text-color has-background\" style=\"border-left-color:#0284c7;border-left-width:6px;border-radius:16px;color:#0c4a6e;background-color:#e0f2fe;margin-bottom:var(--wp--preset--spacing--70);padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">A real window, with an honest tradeoff</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>The companion is a shell-managed sibling that loads the same post in a second Gutenberg document. That boundary is what lets plugin-owned React panels behave normally outside the source iframe. OpenStation parks the source sidebar while the companion is active, then restores it when the companion closes.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Built for the panels you already use</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"style\":{\"typography\":{\"fontSize\":\"1.1rem\",\"lineHeight\":\"1.7\"}}} -->\n<p style=\"font-size:1.1rem;line-height:1.7\">Document settings, block controls, publishing checks, SEO tools, custom fields, and other Gutenberg extensions can remain in view without repeatedly covering your content. The result feels simple: one writing surface, one narrow control surface, both visible at once.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:separator {\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|70\",\"bottom\":\"var:preset|spacing|50\"}}}} -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\" style=\"margin-top:var(--wp--preset--spacing--70);margin-bottom:var(--wp--preset--spacing--50)\"/>\n<!-- /wp:separator -->\n\n<!-- wp:paragraph {\"align\":\"center\",\"style\":{\"typography\":{\"fontSize\":\"0.95rem\"},\"color\":{\"text\":\"#64748b\"}}} -->\n<p class=\"has-text-align-center has-text-color\" style=\"color:#64748b;font-size:0.95rem\">Try changing a block, opening its settings, and moving the connected editor pair. This page is yours to experiment with.</p>\n<!-- /wp:paragraph -->\nHTML;\n\n$existing = get_page_by_path('meet-sidebar-window', OBJECT, 'page');\n$page_data = array(\n    'post_title' => 'Meet Sidebar Window',\n    'post_name' => 'meet-sidebar-window',\n    'post_status' => 'publish',\n    'post_type' => 'page',\n    'post_content' => $content,\n    'post_author' => (int) $admin->ID,\n    'comment_status' => 'closed',\n);\nif ($existing instanceof WP_Post) {\n    $page_data['ID'] = (int) $existing->ID;\n    $page_id = wp_update_post($page_data, true);\n} else {\n    $page_id = wp_insert_post($page_data, true);\n}\nif (is_wp_error($page_id)) {\n    throw new RuntimeException($page_id->get_error_message());\n}\n\nupdate_user_meta((int) $admin->ID, 'desktop_mode_mode', '1');\nif (function_exists('openstation_clear_session')) {\n    openstation_clear_session((int) $admin->ID);\n} else {\n    delete_user_meta((int) $admin->ID, 'desktop_mode_session');\n}\n\n$editor_url = add_query_arg(\n    array(\n        'post' => (int) $page_id,\n        'action' => 'edit',\n        'openstation_sidebar_window_auto' => '1',\n    ),\n    admin_url('post.php')\n);\nif (!function_exists('openstation_set_default_window') || !openstation_set_default_window((int) $admin->ID, $editor_url)) {\n    throw new RuntimeException('Could not set the OpenStation default window.');\n}\n"
    }
  ]
}
